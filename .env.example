# ───────────── SERVER ─────────────

# Translation provider: google | openai. One provider for all languages
PROVIDER=google|openai

# Google Gemini (PROVIDER=google): Google AI Studio key, same rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-live-translate-preview

# OpenAI (PROVIDER=openai): key used only by the server, never leaves the container
OPENAI_API_KEY=
OPENAI_MODEL=gpt-realtime-translate

# Provider sessions expire (Gemini ~10 min, OpenAI 60 min): the server opens a replacement this many ms
# before expiry. Empty = provider default (OpenAI 5 min, Gemini 2 min). Set it only to test the rotation
#ROTATE_MARGIN_MS=

# Shared secret ffmpeg -> server for POST /ingest (header: Authorization: Bearer <INGEST_TOKEN>)
# Generate with: openssl rand -hex 32
INGEST_TOKEN=changeme

# Shared secret web server -> server for GET /info (languages, capabilities, listeners...). Read by the
# Next route handler too: on Vercel set it by hand, without NEXT_PUBLIC_. Generate with: openssl rand -hex 32
INFO_TOKEN=changeme

# Shared secret web server -> server: signs the listener ticket (JWT, 50 s) the page sends on GET /listen.
# Read by the Next Server Action (web/app/ticket.js): on Vercel set it by hand, without NEXT_PUBLIC_, it must
# never reach the browser. Generate with: openssl rand -hex 32
LISTEN_SECRET=changeme

# Ingest is dropped (and the provider sessions closed) after this many ms without audio bytes. The source must stream continuously, silence included: no bytes means a dead link
INGEST_IDLE_MS=15000

# Server port (most hosts inject their own)
PORT=8000

# Target languages, one provider session each (billed per session minute, see the costs section in the README).
# Read by the server; the web page gets the list from GET /info through its own server (web/app/api/info/route.js)
TARGET_LANGS=en,it

# ───────────── WEB ─────────────

# Server URL the page connects to: ws://host:port locally, wss://host in production.
# NEXT_PUBLIC_ = inlined into the browser bundle at build time by Next; the root .env is loaded by web/next.config.mjs.
# The Next server also needs INFO_TOKEN and LISTEN_SECRET (above)
NEXT_PUBLIC_SERVER_URL=ws://localhost:8000
